{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WOA Scene State Ledger",
  "type": "object",
  "required": [
    "ledger_version",
    "policy",
    "state_model",
    "state_events",
    "snapshots",
    "unresolved"
  ],
  "properties": {
    "ledger_version": {
      "type": "string"
    },
    "policy": {
      "type": "string"
    },
    "state_model": {
      "type": "object"
    },
    "state_events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "event_id",
          "scene_id",
          "source_ref",
          "subject",
          "dimension",
          "value",
          "state_scope",
          "epistemic_status",
          "carry_forward"
        ],
        "properties": {
          "event_id": {
            "type": "string"
          },
          "scene_id": {
            "type": "string",
            "pattern": "^WOA-CH[0-9]{2}-SC[0-9]{2}$"
          },
          "source_ref": {
            "type": "string"
          },
          "source_transcript_index": {
            "type": "integer",
            "minimum": 0
          },
          "subject": {
            "type": "string"
          },
          "dimension": {
            "type": "string"
          },
          "value": {
            "type": "string"
          },
          "state_scope": {
            "type": "string"
          },
          "epistemic_status": {
            "const": "source_explicit"
          },
          "carry_forward": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "snapshots": {
      "type": "array"
    },
    "unresolved": {
      "type": "array"
    }
  }
}
