{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WOA Human Decision Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "decision_id",
    "attempt_id",
    "scene_id",
    "evaluation_id",
    "evaluation_sha256",
    "package_sha256",
    "candidate",
    "decision",
    "approver",
    "decided_at",
    "rationale",
    "canonical_asset_created",
    "canonical_asset_status"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "decision_id": {
      "type": "string"
    },
    "attempt_id": {
      "type": "string"
    },
    "scene_id": {
      "type": "string"
    },
    "evaluation_id": {
      "type": "string"
    },
    "evaluation_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "package_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "candidate": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "decision": {
      "enum": [
        "approve",
        "reject"
      ]
    },
    "approver": {
      "type": "string",
      "minLength": 1
    },
    "decided_at": {
      "type": "string",
      "format": "date-time"
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "canonical_asset_created": {
      "const": false
    },
    "canonical_asset_status": {
      "const": "not_ingested"
    }
  }
}
