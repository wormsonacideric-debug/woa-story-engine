{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"WOA Location Record",
  "type":"object",
  "required":["location_id","name","status","canonical_asset_ids","approved_facts"],
  "properties":{
    "location_id":{"type":"string"},
    "name":{"type":"string"},
    "status":{"enum":["active","inactive","unknown"]},
    "canonical_asset_ids":{"type":"array","items":{"type":"string"}},
    "approved_facts":{"type":"array","items":{"type":"string"}},
    "continuity_constraints":{"type":"array","items":{"type":"string"}}
  },
  "additionalProperties":false
}
