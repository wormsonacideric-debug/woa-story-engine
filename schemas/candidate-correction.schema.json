{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WOA Candidate Correction Link",
  "type": "object",
  "required": [
    "attempt_id",
    "created_at",
    "iteration",
    "parent_attempt",
    "correction_guidance",
    "human_approval_required"
  ],
  "properties": {
    "attempt_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "iteration": {
      "type": "integer",
      "minimum": 2,
      "maximum": 3
    },
    "parent_attempt": {
      "type": "object",
      "required": [
        "attempt_id",
        "evaluation_id",
        "evaluation_sha256",
        "candidate_sha256"
      ],
      "properties": {
        "attempt_id": {
          "type": "string"
        },
        "evaluation_id": {
          "type": "string"
        },
        "evaluation_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "candidate_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "correction_guidance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "human_approval_required": {
      "const": true
    }
  },
  "additionalProperties": false
}
