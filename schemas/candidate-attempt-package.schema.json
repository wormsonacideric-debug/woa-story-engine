{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WOA Candidate Attempt Package",
  "type": "object",
  "required": ["attempt_id", "scene_id", "created_at", "status", "iteration", "reference_manifest_id", "input_lock_sha256", "prompt_sha256", "human_approval_required"],
  "properties": {
    "attempt_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{5,79}$"},
    "scene_id": {"type": "string", "pattern": "^WOA-[A-Z0-9-]+$"},
    "created_at": {"type": "string", "format": "date-time"},
    "status": {"const": "prepared"},
    "iteration": {"const": 1},
    "reference_manifest_id": {"type": "string"},
    "input_lock_sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "prompt_sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "provider": {"type": "null"},
    "model": {"type": "null"},
    "output": {"type": "null"},
    "lifecycle": {"type": "string"},
    "human_approval_required": {"const": true}
  },
  "additionalProperties": false
}
